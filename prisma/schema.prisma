// =============================================================================
// Prisma Schema — Quản lý Thành tích Giáo viên
// Stack: Prisma ORM + Supabase PostgreSQL
// Last updated: 2026-05-16
// =============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  ADMIN
  TEACHER
}

enum TaskResult {
  NOT_COMPLETED
  GOOD
  EXCELLENT
}

enum PartyRating {
  GOOD
  EXCELLENT
}

enum TitleLevel {
  SCHOOL
  DISTRICT
  CITY
}

enum AchievementMethod {
  METHOD_1
  METHOD_2
}

enum SKKNLevel {
  SCHOOL
  DISTRICT
  CITY
}

enum SKKNStatus {
  UNUSED
  USED
}

enum AwardType {
  CERTIFICATE           // Giấy khen
  COMMENDATION          // Bằng khen
  CERTIFICATE_OF_MERIT  // Giấy chứng nhận
}

// =============================================================================
// USER + TEACHER PROFILE
// =============================================================================

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(TEACHER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  teacherProfile TeacherProfile?

  @@index([email])
  @@map("users")
}

model TeacherProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  fullName      String
  dateOfBirth   DateTime?
  department    String
  teachingSince Int
  isPartyMember Boolean   @default(false)
  partyJoinDate DateTime?

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearlyRecords YearlyRecord[]
  skkns         SKKN[]
  awards        Award[]

  @@index([userId])
  @@map("teacher_profiles")
}

// =============================================================================
// YEARLY RECORD
// =============================================================================

model YearlyRecord {
  id           String      @id @default(cuid())
  teacherId    String
  academicYear String
  taskResult   TaskResult
  partyRating  PartyRating?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  teacher           TeacherProfile     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  competitionTitles CompetitionTitle[]

  @@unique([teacherId, academicYear])
  @@index([teacherId])
  @@map("yearly_records")
}

// =============================================================================
// DANH HIỆU (Achievement Title Catalog — Admin-configurable)
// Thay thế enum CompetitionTitleType cứng; Admin CRUD qua /admin/danh-hieu
// =============================================================================

model DanhHieu {
  id          String   @id @default(cuid())
  name        String   @unique  // "Chiến sĩ thi đua cơ sở", "GV Giỏi", ...
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competitionTitles CompetitionTitle[]
  eligibilityRules  EligibilityRule[]

  @@index([isActive])
  @@map("danh_hieus")
}

// =============================================================================
// COMPETITION TITLE (Danh hiệu thi đua)
// =============================================================================

model CompetitionTitle {
  id                String             @id @default(cuid())
  yearlyRecordId    String
  danhHieuId        String             // FK → DanhHieu (thay thế enum type cũ)
  level             TitleLevel?
  achievementMethod AchievementMethod?

  yearlyRecord YearlyRecord @relation(fields: [yearlyRecordId], references: [id], onDelete: Cascade)
  danhHieu     DanhHieu     @relation(fields: [danhHieuId], references: [id])

  @@index([yearlyRecordId])
  @@index([danhHieuId])
  @@map("competition_titles")
}

// =============================================================================
// SKKN
// =============================================================================

model SKKN {
  id           String     @id @default(cuid())
  teacherId    String
  title        String
  level        SKKNLevel
  rating       String
  academicYear String
  status       SKKNStatus @default(UNUSED)
  usedFor      String?
  usedYear     String?
  createdAt    DateTime   @default(now())

  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  awardSkkns   AwardSKKN[]

  @@index([teacherId])
  @@index([status])
  @@index([teacherId, status])
  @@map("skkns")
}

// =============================================================================
// AWARD
// =============================================================================

model Award {
  id             String    @id @default(cuid())
  teacherId      String
  type           AwardType
  issuingLevel   String
  content        String
  year           String
  decisionNumber String?   // Số quyết định
  decisionDate   DateTime? // Ngày ra quyết định
  attachmentUrls Json      @default("[]") // [{url,name,fileType}]
  createdAt      DateTime  @default(now())

  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  awardSkkns   AwardSKKN[]

  @@index([teacherId])
  @@index([year])
  @@map("awards")
}

// =============================================================================
// AWARD <-> SKKN junction
// =============================================================================

model AwardSKKN {
  id      String @id @default(cuid())
  awardId String
  skknId  String

  award   Award  @relation(fields: [awardId], references: [id], onDelete: Cascade)
  skkn    SKKN   @relation(fields: [skknId], references: [id], onDelete: Cascade)

  @@unique([awardId, skknId])
  @@index([awardId])
  @@index([skknId])
  @@map("award_skkns")
}

// =============================================================================
// ELIGIBILITY RULE — Rule-driven, không hardcode (ADR-005, ADR-007)
//
// conditions: EligibilityConditions JSON
//   {
//     anyOf: Array<{               ← OR: ít nhất 1 nhóm phải thỏa
//       label?: string             ← "Cách 1", "Cách 2"
//       conditions: Condition[]    ← AND: tất cả điều kiện trong nhóm
//     }>
//   }
//
// Backward compat: nếu là Condition[] (array thuần), engine tự wrap thành
// { anyOf: [{ conditions: [...] }] } (single group, all AND).
// =============================================================================

model EligibilityRule {
  id          String   @id @default(cuid())
  danhHieuId  String?  // Optional FK → DanhHieu
  targetTitle String   // Display name (có thể đồng bộ từ danhHieu.name)
  conditions  Json     // EligibilityConditions { anyOf: ConditionGroup[] }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  danhHieu    DanhHieu? @relation(fields: [danhHieuId], references: [id])

  @@index([targetTitle])
  @@index([isActive])
  @@map("eligibility_rules")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("departments")
}
